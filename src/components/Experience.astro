---
import Icon from './Icon.astro';
import { experience } from '../data/experience';

/** Renders `**bold**` spans without pulling in a markdown parser. */
const inline = (text: string) =>
  text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<section class="section section--ruled" id="experience">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">
        <Icon name="briefcase" size={13} />
        01 — Experience
      </span>
      <h2 class="section-title">
        Where I've <span class="grad-text">shipped</span>
      </h2>
      <p class="section-subtitle">
        Hands-on delivery across mobile, web and games — from sprint planning to
        production releases.
      </p>
    </div>

    <ol class="timeline">
      {experience.map((job) => (
        <li class="timeline-item reveal">
          <div class="timeline-marker" aria-hidden="true">
            <span class="timeline-dot"></span>
          </div>

          <article class="timeline-card card tilt" data-tilt data-tilt-max="4">
            <div class="timeline-head lift-1">
              <div class="timeline-title">
                <h3>{job.role}</h3>
                <p class="timeline-company">
                  <span class="company-name">{job.company}</span>
                  <span class="company-dot" aria-hidden="true"></span>
                  <span class="timeline-duration">{job.duration}</span>
                </p>
              </div>
              <span class="timeline-badge">
                <Icon name="verified" size={13} />
                Professional
              </span>
            </div>

            <ul class="timeline-bullets lift-1">
              {job.bullets.map((b) => (
                <li set:html={inline(b)} />
              ))}
            </ul>

            <ul class="timeline-tech lift-2">
              {job.tech.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding-left: 2.5rem;
  }

  /* The spine: a gradient line that fades out at both ends. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--primary) 12%,
      var(--cyan) 60%,
      transparent
    );
    opacity: 0.45;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: -2.5rem;
    top: 1.9rem;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg-1);
    border: 1px solid var(--line-accent);
    box-shadow: 0 0 0 5px rgba(6, 8, 14, 0.9), 0 0 22px -2px var(--primary-glow);
  }

  .timeline-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary-light);
    box-shadow: 0 0 10px var(--primary-light);
  }

  .timeline-card {
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  /* Gradient edge that lights up on hover. */
  .timeline-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(130deg, var(--primary), transparent 40%, transparent 60%, var(--cyan));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out);
    pointer-events: none;
  }

  .timeline-card:hover::after {
    opacity: 1;
  }

  .timeline-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }

  .timeline-title h3 {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    margin-bottom: 0.35rem;
  }

  .timeline-company {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-size: 0.88rem;
  }

  .company-name {
    font-weight: 700;
    color: var(--cyan-light);
  }

  .company-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--faint);
  }

  .timeline-duration {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--dim);
  }

  .timeline-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.34rem 0.7rem;
    border-radius: var(--r-full);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.26);
    color: #6ee7b7;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .timeline-bullets {
    display: grid;
    gap: 0.7rem;
    margin-bottom: 1.35rem;
  }

  .timeline-bullets li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.72;
  }

  .timeline-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--primary-light), var(--cyan));
    rotate: 45deg;
  }

  .timeline-bullets :global(strong) {
    color: var(--text);
    font-weight: 700;
  }

  .timeline-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-soft);
  }

  @media (max-width: 640px) {
    .timeline {
      padding-left: 2rem;
    }

    .timeline::before {
      left: 8px;
    }

    .timeline-marker {
      left: -2rem;
      width: 20px;
      height: 20px;
    }
  }
</style>
