---
import Icon from './Icon.astro';
import { site, socials, contactMethods } from '../data/site';
---

<section class="section section--ruled" id="contact">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">
        <Icon name="mail" size={13} />
        05 — Contact
      </span>
      <h2 class="section-title">
        Let's build <span class="grad-text">something</span>
      </h2>
      <p class="section-subtitle">
        Open to roles, freelance projects and collaborations. I usually reply
        within a day.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Left: channels -->
      <div class="contact-side reveal">
        <div class="contact-card card">
          <h3>Direct lines</h3>
          <p class="contact-card-sub">
            Prefer email or a quick message? Both land with me directly.
          </p>

          <ul class="method-list">
            {contactMethods.map((m) => (
              <li class="method">
                <span class="method-icon">
                  <Icon name={m.icon as any} size={17} />
                </span>

                <span class="method-body">
                  <small>{m.label}</small>
                  {m.href ? (
                    <a
                      href={m.href}
                      target={m.href.startsWith('http') ? '_blank' : undefined}
                      rel={m.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                      {m.value}
                    </a>
                  ) : (
                    <span>{m.value}</span>
                  )}
                </span>

                {m.copy && (
                  <button
                    class="method-copy"
                    type="button"
                    data-copy={m.copy}
                    aria-label={`Copy ${m.label}`}
                    title="Copy to clipboard"
                  >
                    <Icon name="copy" size={15} />
                  </button>
                )}
              </li>
            ))}
          </ul>

          <div class="contact-socials">
            {socials.map((s) => (
              <a
                class="social-btn"
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
              >
                <Icon name={s.icon as any} size={18} />
              </a>
            ))}
          </div>
        </div>

        <a class="resume-cta card" href={site.resumeUrl} download>
          <span class="resume-icon"><Icon name="fileText" size={20} /></span>
          <span class="resume-body">
            <strong>Download my resume</strong>
            <small>PDF — updated 2026</small>
          </span>
          <Icon name="download" size={17} class="resume-arrow" />
        </a>
      </div>

      <!-- Right: form -->
      <form
        class="contact-form card reveal"
        id="contactForm"
        action={site.formEndpoint}
        method="POST"
        style="--reveal-delay:100ms"
        novalidate
      >
        <h3>Send a message</h3>

        <div class="field-row">
          <div class="field">
            <label for="name">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              placeholder="Your name"
              autocomplete="name"
              required
            />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>
        </div>

        <div class="field">
          <label for="subject">Subject</label>
          <input
            id="subject"
            name="subject"
            type="text"
            placeholder="What's this about?"
            required
          />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Tell me about the project or role…"
            required
          ></textarea>
        </div>

        <!-- Honeypot: bots fill this, humans never see it. -->
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="honeypot"
        />

        <button class="btn btn-primary submit" type="submit">
          <span class="submit-label">Send Message</span>
          <Icon name="send" size={17} />
        </button>

        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  import { toast } from '../scripts/motion.ts';

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const status = document.getElementById('formStatus');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!status) return;

    // Let the browser surface its own validation UI first.
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('.submit');
    const label = button?.querySelector('.submit-label');
    const original = label?.textContent ?? 'Send Message';

    if (button) button.disabled = true;
    if (label) label.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'form-status';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) throw new Error(`Request failed: ${response.status}`);

      status.textContent = "Message sent — thanks! I'll get back to you shortly.";
      status.classList.add('is-success');
      form.reset();
      toast('Message sent');
    } catch {
      // Never swallow the user's words: keep the form populated on failure.
      status.textContent =
        'Something went wrong. Please email me directly at stevenvianto@gmail.com.';
      status.classList.add('is-error');
    } finally {
      if (button) button.disabled = false;
      if (label) label.textContent = original;
    }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.4rem;
    align-items: start;
  }

  .contact-side {
    display: grid;
    gap: 1rem;
  }

  /* --- Direct lines card --- */
  .contact-card {
    padding: clamp(1.35rem, 3vw, 1.85rem);
  }

  .contact-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .contact-card-sub {
    font-size: 0.85rem;
    color: var(--dim);
    margin-bottom: 1.4rem;
    line-height: 1.6;
  }

  .method-list {
    display: grid;
    gap: 0.65rem;
  }

  .method {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-soft);
    background: rgba(255, 255, 255, 0.022);
    transition:
      border-color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .method:hover {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.045);
  }

  .method-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 9px;
    color: var(--primary-light);
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .method-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }

  .method-body small {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .method-body a,
  .method-body > span {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text);
    overflow-wrap: anywhere;
    transition: color var(--t-fast) var(--ease-out);
  }

  .method-body a:hover {
    color: var(--cyan-light);
  }

  .method-copy {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 8px;
    color: var(--dim);
    border: 1px solid transparent;
    transition:
      color var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .method-copy:hover {
    color: var(--text);
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.06);
  }

  .contact-socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.4rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line-soft);
  }

  .social-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: var(--glass);
    color: var(--muted);
    transition:
      color var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out),
      transform var(--t-base) var(--ease-spring);
  }

  .social-btn:hover {
    color: #fff;
    border-color: var(--line-accent);
    transform: translateY(-3px);
  }

  /* --- Resume CTA --- */
  .resume-cta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.25rem;
    transition:
      border-color var(--t-base) var(--ease-out),
      transform var(--t-base) var(--ease-spring);
  }

  .resume-cta:hover {
    border-color: var(--line-accent);
    transform: translateY(-2px);
  }

  .resume-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    color: var(--cyan-light);
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.22);
  }

  .resume-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .resume-body strong {
    font-size: 0.9rem;
  }

  .resume-body small {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--dim);
  }

  .resume-arrow {
    color: var(--dim);
  }

  /* --- Form --- */
  .contact-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.35rem, 3vw, 1.85rem);
  }

  .contact-form h3 {
    font-size: 1.15rem;
    margin-bottom: 0.15rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.72rem 0.9rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    background: rgba(6, 8, 14, 0.6);
    color: var(--text);
    font-size: 0.9rem;
    resize: vertical;
    transition:
      border-color var(--t-fast) var(--ease-out),
      box-shadow var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--faint);
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--line-hi);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--primary);
    background: rgba(6, 8, 14, 0.85);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.16);
  }

  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: var(--rose);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .submit {
    justify-self: start;
    margin-top: 0.25rem;
  }

  .submit:disabled {
    opacity: 0.65;
    cursor: progress;
    transform: none;
  }

  .form-status {
    font-size: 0.82rem;
    min-height: 1.2em;
  }

  .form-status.is-success {
    color: #6ee7b7;
  }

  .form-status.is-error {
    color: #fda4af;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .submit {
      width: 100%;
    }
  }
</style>
