interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 20, stroke = 2, class: className = '' } = Astro.props;
const markup = paths[name];

if (!markup) {
  throw new Error(
    `Icon "${name}" does not exist. Available: ${Object.keys(paths).join(', ')}`
  );
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>
