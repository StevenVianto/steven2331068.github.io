---
import Icon from './Icon.astro';
import {
  certifications,
  education,
  languages,
  achievements,
} from '../data/credentials';

const inline = (text: string) =>
  text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<section class="section section--ruled" id="credentials">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">
        <Icon name="graduationCap" size={13} />
        04 — Credentials
      </span>
      <h2 class="section-title">
        Education & <span class="grad-text">certifications</span>
      </h2>
      <p class="section-subtitle">
        Formal study, industry certifications, and the languages I work in.
      </p>
    </div>

    <div class="cred-grid">
      <!-- Education -->
      <div class="cred-column">
        <h3 class="cred-label">
          <Icon name="book" size={15} />
          Formal Education
        </h3>

        <div class="edu-list">
          {education.map((edu, i) => (
            <article
              class="edu-card card tilt"
              data-tilt
              data-tilt-max="4"
              style={`--reveal-delay:${i * 80}ms`}
            >
              <div class="edu-top lift-1">
                <span class="edu-icon"><Icon name="graduationCap" size={19} /></span>
                <span class="edu-year">{edu.year}</span>
              </div>
              <h4 class="lift-1">{edu.school}</h4>
              <p class="edu-major lift-1">{edu.major}</p>
              <p class="edu-note lift-1">{edu.note}</p>
            </article>
          ))}
        </div>

        <!-- Languages -->
        <h3 class="cred-label cred-label--spaced">
          <Icon name="globe" size={15} />
          Languages
        </h3>

        <div class="lang-card card">
          {languages.map((lang) => (
            <div class="lang-row">
              <div class="lang-meta">
                <span class="lang-name">{lang.name}</span>
                <span class="lang-level">{lang.level}</span>
              </div>
              <div class="lang-meter" role="presentation">
                <span style={`width:${Math.round(lang.proficiency * 100)}%`}></span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Certifications + achievements -->
      <div class="cred-column">
        <h3 class="cred-label">
          <Icon name="award" size={15} />
          Certifications
        </h3>

        <ul class="cert-list">
          {certifications.map((cert, i) => (
            <li
              class="cert-card card tilt"
              data-tilt
              data-tilt-max="4"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="cert-icon lift-1">
                <Icon name={cert.icon as any} size={18} />
              </span>
              <span class="cert-body lift-1">
                <strong>{cert.name}</strong>
                <small>{cert.detail}</small>
              </span>
              <span class="cert-check" aria-hidden="true">
                <Icon name="verified" size={16} />
              </span>
            </li>
          ))}
        </ul>

        <h3 class="cred-label cred-label--spaced">
          <Icon name="sparkle" size={15} />
          Achievements
        </h3>

        <ul class="ach-list card">
          {achievements.map((a) => (
            <li set:html={inline(a)} />
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { reveal, tilt } from '../scripts/motion.ts';
  reveal();
  tilt();
</script>

<style>
  .cred-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1.5rem;
    perspective: 1400px;
  }

  .cred-column {
    display: flex;
    flex-direction: column;
  }

  .cred-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .cred-label :global(svg) {
    color: var(--primary-light);
  }

  .cred-label--spaced {
    margin-top: 1.75rem;
  }

  /* --- Education --- */
  .edu-list {
    display: grid;
    gap: 1rem;
  }

  .edu-card {
    padding: 1.35rem;
    transform-style: preserve-3d;
    transition: border-color var(--t-base) var(--ease-out);
  }

  .edu-card:hover {
    border-color: var(--line-accent);
  }

  .edu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .edu-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: var(--cyan-light);
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.22);
  }

  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--dim);
    padding: 0.26rem 0.6rem;
    border-radius: var(--r-full);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    white-space: nowrap;
  }

  .edu-card h4 {
    font-size: 1.03rem;
    margin-bottom: 0.2rem;
  }

  .edu-major {
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--primary-light);
    margin-bottom: 0.6rem;
  }

  .edu-note {
    font-size: 0.84rem;
    line-height: 1.66;
    color: var(--muted);
  }

  /* --- Languages --- */
  .lang-card {
    display: grid;
    gap: 1rem;
    padding: 1.35rem;
  }

  .lang-row {
    display: grid;
    gap: 0.5rem;
  }

  .lang-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .lang-name {
    font-size: 0.89rem;
    font-weight: 600;
  }

  .lang-level {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--dim);
    text-align: right;
  }

  .lang-meter {
    height: 5px;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .lang-meter span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--primary), var(--cyan-light));
    box-shadow: 0 0 12px -2px var(--cyan-glow);
  }

  /* --- Certifications --- */
  .cert-list {
    display: grid;
    gap: 0.7rem;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    transform-style: preserve-3d;
    transition:
      border-color var(--t-base) var(--ease-out),
      background-color var(--t-base) var(--ease-out);
  }

  .cert-card:hover {
    border-color: rgba(16, 185, 129, 0.34);
  }

  .cert-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 10px;
    color: var(--emerald);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.22);
  }

  .cert-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .cert-body strong {
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .cert-body small {
    font-size: 0.74rem;
    color: var(--dim);
  }

  .cert-check {
    margin-left: auto;
    color: rgba(16, 185, 129, 0.55);
    flex-shrink: 0;
  }

  /* --- Achievements --- */
  .ach-list {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1.35rem;
  }

  .ach-list li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .ach-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--amber), var(--rose));
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
  }

  .ach-list :global(strong) {
    color: var(--text);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .cred-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
